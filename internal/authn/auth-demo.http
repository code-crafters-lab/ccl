### 1. PKCE 授权码流程
# 1.1 获取授权码 浏览器打开以下地址 redirect_url 不能使用 localhost
GET http://localhost/oauth2/authorize?client_id=web&response_type=code&scope=openid&redirect_uri=http://localhost:5000/auth/callback&code_challenge_method=S256&code_challenge=uh5zryRg8UqzGuXk7ao9V0Smo34i7icPBrubVWkDgEw

###
# 1.2 根据授权码获取 token (client_secret_post)
POST http://localhost/oauth2/token
Content-Type: application/x-www-form-urlencoded

client_id=web&grant_type=authorization_code&code=u4ZH9YT85163aQ3W5QIMhkME&code_verifier=BUn8vDyURwERA1n~LtuC7CbGGgsvJp_CSAs-SvRbIZPGXkqFeXJC29Lc.TDZqIrJ&redirect_uri=http://localhost:5000/auth/callback

###
# 1.3 获取用户信息
GET http://localhost:9998/oauth2/userinfo

###

# 2. 根据刷新令牌获取token
POST http://localhost:9000/oauth2/token
Content-Type: application/x-www-form-urlencoded

client_id=demo&client_secret=123456&grant_type=refresh_token&refresh_token=61OqTQucWsE9zTsLOr4tNFTTaatnfqkfBILMgNQif9HSLvUwkLrAdq6Qetea5zZX69bOk9454cbgM0nz6rWdb0eARkOOyxqac_9qmaJai-EpCn1ZhLfYssvBNsk1yDK3

###
# 3. 客户端凭证(此模式下，没有用户的参与，只有客户端和授权服务器之间的参与)
POST http://localhost:9000/oauth2/token
Content-Type: application/x-www-form-urlencoded

client_id=demo&client_secret=123456&grant_type=client_credentials

### 4.密码模式
POST http://localhost:9000/oauth2/token
Content-Type: application/x-www-form-urlencoded

client_id=demo&client_secret=123456&grant_type=password&username=root&password=123456

### client_id=demo&client_secret=123456&grant_type=password&username=root&password=123456

###
# 5. 撤销令牌
POST http://localhost/oauth2/revoke
Authorization: Basic d2ViOg==
Content-Type: application/x-www-form-urlencoded

token=khSh9iaUOewUEGBVomW_hYjNFX0lJOhd8YYBhj71mjxJs9MN

###
# 6. 查看 token 的信息（令牌内省）
POST http://localhost/oauth2/introspect
Content-Type: application/x-www-form-urlencoded
Authorization: Basic d2ViOg==

client_id=web&token=khSh9iaUOewUEGBVomW_hYjNFX0lJOhd8YYBhj71mjxJs9MN

###
# 7. 查看JWK信息
GET http://localhost/oauth2/jwks
