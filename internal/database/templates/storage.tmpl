{{/* gotype: entgo.io/ent/entc/gen.Graph */}}

{{ define "oauth2_storage" }}

    {{/* Add the base header for the generated file */}}
    {{ $pkg := base $.Config.Package }}
    {{ template "header" $ }}

    import (
    "github.com/zitadel/oidc/v3/pkg/oidc"
    "github.com/zitadel/oidc/v3/pkg/op"
    )

    {{/* Loop over all nodes and implement the "GoStringer" interface */}}
    {{ range $n := $.Nodes -}}
        {{ if hasPrefix $n.Name "OAuth2" }}
            {{/* 客户端 Storge 实现 */}}
            {{ if eq $n.Name "OAuth2Client" }}
                {{ template "oauth2_storage/helper/client" $n }}
            {{ end }}
            {{ if eq $n.Name "OAuth2Authorization" }}
                {{ template "oauth2_storage/helper/authorization" $n }}
            {{ end }}
            {{ if eq $n.Name "OAuth2AuthorizationCode" }}
                {{ template "oauth2_storage/helper/authorization_code" $n }}
            {{ end }}
        {{ end }}
    {{ end }}

{{ end }}